<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD polkit Policy Configuration 1.0//EN"
"http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>

  <vendor>CachyOS</vendor>
  <vendor_url>https://github.com/CachyOS/packageinstaller</vendor_url>

  <action id="org.cachyos.cachyos-pi.manage-packages">
    <description>Install, remove or update packages, or rank the mirrors</description>
    <message>Authentication is required to install, remove or update packages, or to rank the mirrors</message>
    <icon_name>cachyos-pi</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@PI_HELPER_DIR@/cachyos-pi-helper</annotate>
  </action>

</policyconfig>
